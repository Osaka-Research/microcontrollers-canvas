{
  "name": "microcontrollers-canvas",
  "version": "1.0.0",
  "private": true,
  "description": "Local development runtime for Microcontrollers Canvas",
  "scripts": {
    "build": "node scripts/build-dist.mjs",
    "build:siwc": "npm run build --prefix vendor/siwc-local",
    "start": "node scripts/serve-local-canvas.mjs",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "worker:adafruit": "node scripts/adafruit-catalog-worker.mjs",
    "worker:adafruit:status": "node scripts/adafruit-catalog-worker.mjs --status",
    "worker:templates": "node scripts/template-catalog-worker.mjs",
    "worker:templates:status": "node scripts/template-catalog-worker.mjs --status",
    "worker:photos": "node scripts/photo-audit-worker.mjs",
    "worker:photos:status": "node scripts/photo-audit-worker.mjs --status"
  },
  "dependencies": {
    "@siwc/local": "file:vendor/siwc-local"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.8.3"
  }
}
